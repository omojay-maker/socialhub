# ---------------------------------------------------------------- runtime ----
APP_ENV=development
APP_DEBUG=true
# Public origin of the app. The OAuth redirect URIs are derived from this as
#   <APP_URL>/public/api/oauth.php?action=callback&platform=<slug>
# so the value here must match what you register in each developer portal.
APP_URL=http://localhost/PHP_projects/social-hub
# 32+ random bytes. Generate with: php -r 'echo bin2hex(random_bytes(32));'
# Rotating this invalidates every stored OAuth token.
APP_KEY=
# 'mock' simulates publishing; 'live' calls the real platform APIs.
SOCIAL_MODE=mock

# ----------------------------------------------------------------- database --
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_hub
DB_USERNAME=root
DB_PASSWORD=root

# ----------------------------------------------------------------- security --
# Idle timeout in seconds (sliding).
SESSION_TIMEOUT=1800
# auto | 1 | 0  (auto = secure cookie only on HTTPS requests)
SESSION_SECURE=auto
# Comma separated proxy IPs allowed to set X-Forwarded-Proto.
TRUSTED_PROXIES=
# Login throttling: attempts / window seconds.
LOGIN_RATE_IP=10
LOGIN_RATE_ACCOUNT=5

# ------------------------------------------------------------------- uploads --
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mov,avi,webm
# Public origin platforms can fetch media from. Required for Instagram, TikTok
# and Facebook publishing. Must be a public HTTPS origin.
PUBLIC_MEDIA_BASE=

# --------------------------------------------------------------------- OAuth --
# Fill in the platforms you connect. Set SOCIAL_MODE=live to enable the
# "Connect" buttons. Walkthrough: docs/oauth-setup.md

# --- Meta: Facebook + Instagram (one app covers both) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v21.0
META_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v21.0

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Blank defaults to two months ago. Set to post as a company page instead of
# the member: urn:li:organization:123456
LINKEDIN_ORGANIZATION_URN=

# --- TikTok (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# DIRECT_POST publishes to the feed; MEDIA_UPLOAD sends a draft to the app.
TIKTOK_POST_MODE=DIRECT_POST
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# --- X (Twitter) — OAuth 2.0 PKCE ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=
# X write endpoints need an OAuth 1.0a user token. Generate one in the developer
# portal under your app, or run the generator at the bottom of docs/oauth-setup.md
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

 opencode -s ses_f17859c07ffe4WjLWtGw16BLIB